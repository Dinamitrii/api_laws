{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "site-creator-vinext-starter",
	"compatibility_date": "2026-05-22",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "vinext/server/fetch-handler",
	"assets": {
		"directory": "dist/client",
		"not_found_handling": "none",
		"binding": "ASSETS"
	},
	"cache": {
		"enabled": true
	},
	"images": {
		"binding": "IMAGES"
	},
	"kv_namespaces": [
		{
			"binding": "VINEXT_KV_CACHE",
			"id": "<your-kv-namespace-id>"
		},
		{
			"binding": "predictorian",
			"id": "2ef4c2601101466e9734713e309aaf6b"
		}
	],
	"d1_databases": [
		{
			"binding": "AUTH_DB",
			"database_name": "predictorian-users",
			"database_id": "9accc34a-7dea-4572-abe5-c0922583217d",
			"migrations_dir": "migrations"
		}
	]
}
