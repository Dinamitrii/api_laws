{
  "name": "firmi-app",
  "version": "0.1.0",
  "private": true,
  "description": "Просто приложение на български за TheCompanyBook.",
  "license": "ISC",
  "author": "",
  "type": "module",
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test": "node --test \"tests/*.test.cjs\"",
    "db:generate": "drizzle-kit generate",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "start:vinext": "vinext start",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json --experimental-warm-cdn-cache"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@hookform/resolvers": "^5.9.1",
    "@shadcn/react": "^0.3.1",
    "@vinext/cloudflare": "^1.1.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.56.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.2.6",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.90.0",
    "react-resizable-panels": "^4.14.5",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.37",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "json-rpc-2.0": "1.7.1",
    "raw-body": "3.0.2",
    "react-server-dom-webpack": "^19.3.0",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "^1.1.0",
    "vite": "^8.3.4",
    "wrangler": "4.92.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  },
  "allowScripts": {
    "workerd@1.20260515.1": true,
    "unrs-resolver@1.12.2": true,
    "esbuild@0.28.2": true
  }
}
